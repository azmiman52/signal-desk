# Local loopback development only. Never reuse this password for hosting.
# Keep URL-reserved characters out of this local password (or encode DATABASE_URL).
POSTGRES_PASSWORD=signaldesk-local-only
MIGRATOR_PASSWORD=signaldesk-migrator-local-only
APP_DATABASE_PASSWORD=signaldesk-app-local-only
POSTGRES_PORT=5433
API_PORT=8000
WEB_PORT=8080
# Native backend configuration (Compose supplies its own internal DB URL).
DATABASE_URL=postgresql://signaldesk_app:signaldesk-app-local-only@127.0.0.1:5433/signaldesk
APP_ENV=development
MAX_ACCOUNTS=100
APP_ORIGIN=http://127.0.0.1:8080
GITHUB_REDIRECT_URI=http://127.0.0.1:8080/api/v1/auth/github/callback
# Register a GitHub OAuth App, then set credentials only in ignored .env.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional dedicated public-read collector token; never reuse the OAuth secret.
# Empty uses GitHub's unauthenticated public API allowance.
GITHUB_COLLECTOR_TOKEN=
# Integration tests use a dedicated disposable DB; never set this to real data.
# TEST_DATABASE_URL=postgresql://signaldesk:signaldesk-test-only@127.0.0.1:5434/signaldesk_test
